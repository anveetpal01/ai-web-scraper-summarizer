# Copy this file to `backend/.env` and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: any Gemini model that supports generateContent.
# Defaults to gemini-3.5-flash-lite (fast and available on the free tier).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated list of frontend URLs allowed to call this API.
# Defaults to http://localhost:3000. Set it to your deployed frontend URL in production.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
